---
layout: null
permalink: /notes.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }} | Notes</title>
  <link href="{{ "/notes.xml" | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ "/notes/" | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ "/notes.xml" | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name><uri>{{ "/" | absolute_url }}</uri></author>
  {%- assign notes = site.notes | sort: "date" | reverse -%}
  {%- for note in notes limit: 50 %}
  <entry>
    {%- assign plain = note.content | strip_html | normalize_whitespace -%}
    <title>{{ plain | truncate: 60 | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ note.url | absolute_url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.date | date_to_xmlschema }}</updated>
    <content type="html" xml:base="{{ note.url | absolute_url }}">{{ note.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
